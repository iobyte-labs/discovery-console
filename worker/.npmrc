# Refuse to install when the Node version does not satisfy "engines" in package.json.
#
# npm's default is to warn and carry on, which means a wrong Node gets discovered later as
# a confusing wrangler error rather than here as one sentence. Deploying is rare enough
# that nobody remembers which Node it needed.
engine-strict=true

# Exact versions for anything added later. A deploy tool that silently moves to a new
# minor is the thing the pinned version and the lockfile exist to prevent.
save-exact=true
